{
  "projectType": "cli-tool",
  "projectName": "Nano",
  "projectDescription": "Nano is a human-readable coding language that compiles to x86-64 assembly (NASM), designed to be simple and Python-like while producing native Windows executables.",
  "theme": "aspen",
  "primaryColor": "#3B82F6",
  "lightColor": "#93C5FD",
  "darkColor": "#1E40AF",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "building-the-compiler"
            ]
          },
          {
